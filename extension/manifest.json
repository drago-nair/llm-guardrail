{
  "manifest_version": 3,
  "name": "LLM Guardrail",
  "version": "1.0.0",
  "description": "Checks a prompt against a local six-gate security pipeline before you send it to any LLM.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://192.168.0.111:8000/*"
  ]
}
